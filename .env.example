# Optional overrides. Defaults create separate local token files under data/.
# Never commit real credentials or copy them into research artifacts.
MATHAGENT_DATABASE=data/mathagent.db
# MATHAGENT_TOKEN=<human-session-secret>
# MATHAGENT_WORKER_TOKEN=<different-worker-secret>

# Copy this template to .env; API and worker load it from their working directory.
# Existing process environment values take precedence. Restart after changes.
# Set MATHAGENT_LOAD_ENV=0 in the process environment to skip loading .env.
# Real calls require the global gate, a configured key AND model, project consent,
# an allowed provider, an explicitly started worker, and remaining request budget.
MATHAGENT_ENABLE_REAL_API=0
# MATHAGENT_DEEPSEEK_API_KEY=<set locally, never paste in research content>
# MATHAGENT_DEEPSEEK_MODEL=<an available model in your account>
# MATHAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional physical input-plus-output capacity in provider tokens; not a research budget.
# Known official models have documented defaults; unknown endpoints/models are not guessed.
# MATHAGENT_DEEPSEEK_CONTEXT_CAPACITY=<positive provider context capacity>
# MATHAGENT_GLM_API_KEY=<set locally>
# MATHAGENT_GLM_MODEL=<an available model in your account>
# MATHAGENT_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MATHAGENT_GLM_CONTEXT_CAPACITY=<positive provider context capacity>
# MATHAGENT_FRONTEND_ORIGIN=http://127.0.0.1:5173
# MATHAGENT_FRONTEND_DIST=<absolute apps/web/dist path when installed separately>

# Optional offline Python sandbox; requires a working local Docker engine.
# Build only the trusted sandbox/ context, then pin its immutable image ID.
# Projects must also explicitly enable the sandbox in their runtime settings.
# MATHAGENT_SANDBOX_IMAGE=sha256:<64 lowercase hexadecimal characters>
